{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "zui": ["src/index.ts"],
      "zui/jsx-runtime": ["src/jsx-runtime.ts"],
      "zui/jsx-dev-runtime": ["src/jsx-dev-runtime.ts"],
      "zui/ui": ["src/ui.ts"],
      "zui/external-store": ["src/external-store.ts"],
      "zui/zustand": ["src/zustand.ts"],
      "zui/dom": ["src/dom.ts"],
      "zui/legacy": ["src/dom.ts"],
      "zui/reactive": ["src/reactive.ts"],
      "zui/flat": ["src/flat.ts"],
      "zui/devtools": ["src/devtools.ts"]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vitest/globals"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "zui"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ]
}
