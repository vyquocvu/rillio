{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "rillio": ["src/index.ts"],
      "rillio/jsx-runtime": ["src/jsx-runtime.ts"],
      "rillio/jsx-dev-runtime": ["src/jsx-dev-runtime.ts"],
      "rillio/external-store": ["src/external-store.ts"],
      "rillio/dom": ["src/dom.ts"],
      "rillio/legacy": ["src/dom.ts"],
      "rillio/reactive": ["src/reactive-api.ts"],
      "rillio/flat": ["src/flat.ts"],
      "rillio/devtools": ["src/devtools.ts"]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vitest/globals"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "rillio"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ]
}
