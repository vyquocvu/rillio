{
  "name": "zui",
  "version": "0.1.0",
  "description": "Experimental addressable-DOM UI runtime and component primitives.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vyquocvu/zui.git"
  },
  "author": "Vy Quoc Vu <vyquocvu@gmail.com>",
  "license": "MIT",
  "keywords": [
    "ui",
    "jsx",
    "dom",
    "typescript",
    "reactive",
    "zustand",
    "external-store"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:package": "tsc -p tsconfig.build.json",
    "test:smoke": "tsc src/reactive.ts --outDir .zui-test --target es2022 --module nodenext --strict --skipLibCheck && node tests/smoke.cjs",
    "bench:smoke": "npm run test:smoke && node benchmarks/smoke.cjs",
    "bench:reactive": "npm run test:smoke && node benchmarks/reactive.cjs",
    "bench:compat": "npm run build:package && node benchmarks/compat.cjs",
    "bench:flat": "npm run build:package && node benchmarks/flat.cjs",
    "bench:patch-planning": "node research/patch-planning/run.mjs",
    "bench:all": "npm run bench:reactive && npm run bench:compat && npm run bench:flat",
    "bench:browser": "node benchmarks/browser-playwright.mjs",
    "bench:cpu-memory": "node benchmarks/cpu-memory.mjs",
    "profile:browser": "node benchmarks/profile-playwright.mjs",
    "test:oracle": "npm run test:smoke && node tests/oracle-smoke.cjs",
    "test:consumer": "npm run build:package && node tests/consumer-smoke.cjs",
    "test:browser": "npm run build:release && node tests/browser-playwright-smoke.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:release": "npm run build && npm run build:package",
    "prepack": "npm run build:package"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "playwright": "^1.64.0",
    "preact": "^11.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "zustand": "^5.0.15"
  },
  "files": [
    "dist/package",
    "README.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js",
      "default": "./dist/package/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/package/jsx-runtime.d.ts",
      "import": "./dist/package/jsx-runtime.js",
      "default": "./dist/package/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/package/jsx-dev-runtime.d.ts",
      "import": "./dist/package/jsx-dev-runtime.js",
      "default": "./dist/package/jsx-dev-runtime.js"
    },
    "./ui": {
      "types": "./dist/package/ui.d.ts",
      "import": "./dist/package/ui.js",
      "default": "./dist/package/ui.js"
    },
    "./external-store": {
      "types": "./dist/package/external-store.d.ts",
      "import": "./dist/package/external-store.js",
      "default": "./dist/package/external-store.js"
    },
    "./dom": {
      "types": "./dist/package/dom.d.ts",
      "import": "./dist/package/dom.js",
      "default": "./dist/package/dom.js"
    },
    "./legacy": {
      "types": "./dist/package/dom.d.ts",
      "import": "./dist/package/dom.js",
      "default": "./dist/package/dom.js"
    },
    "./reactive": {
      "types": "./dist/package/reactive-api.d.ts",
      "import": "./dist/package/reactive-api.js",
      "default": "./dist/package/reactive-api.js"
    },
    "./flat": {
      "types": "./dist/package/flat.d.ts",
      "import": "./dist/package/flat.js",
      "default": "./dist/package/flat.js"
    },
    "./devtools": {
      "types": "./dist/package/devtools.d.ts",
      "import": "./dist/package/devtools.js",
      "default": "./dist/package/devtools.js"
    }
  }
}
